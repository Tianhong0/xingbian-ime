<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    本机 nuget.org 的 V3 服务索引在 dotnet restore 下无法加载（NU1301），
    但包的直链下载正常，因此把所需的 nupkg 预置到仓库内的离线源。
    只保留本地源，避免 restore 再去联网而失败。
  -->
  <packageSources>
    <clear />
    <add key="local-offline" value=".nuget-local" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value=".nuget-packages" />
  </config>
</configuration>
